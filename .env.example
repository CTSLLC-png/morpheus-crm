VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_APP_URL=https://morpheuscr.com

# Read server-side by api/claude.js. The VITE_ prefix is deliberately absent:
# Vite inlines every VITE_-prefixed variable into the browser bundle, so
# naming this VITE_ANTHROPIC_API_KEY would publish the key to anyone who
# views source, and api/claude.js would not find it.
ANTHROPIC_API_KEY=your_anthropic_key_here

# Used by .mcp.json to authenticate the Opus.pro agent-mcp server for Claude Code sessions
OPUS_API_KEY=your_opus_api_key_here
